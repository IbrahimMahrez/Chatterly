# Example environment variables for Chatterly
# Copy this file to `.env` and fill real values. Do NOT commit real secrets.

MONGO_URI=mongodb://localhost:27017/Chatterly
PORT=5000
NODE_ENV=development

# Use a strong secret (example generation: `openssl rand -base64 32`)
JWT_SECRET=REPLACE_WITH_STRONG_SECRET

# Email (used for password reset emails)
EMAIL_USER=you@example.com
EMAIL_PASS=your_email_password_or_app_password

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:5173

# Paymob / Payment integration (fill from Paymob dashboard)
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
REDIRECT_URL=http://localhost:5000/payment/success
WEBHOOK_URL=http://your-server.com/webhook/paymob

# Notes:
# - For Gmail, prefer an App Password for `EMAIL_PASS` (do not use your normal Google password).
# - Keep secrets out of version control. Add `.env` to `.gitignore` if not present.
